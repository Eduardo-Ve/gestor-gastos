generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
}

enum PaymentMethod {
  cash
  debit
  credit
  transfer
  other
}

model Category {
  id            String          @id @default(cuid())
  name          String
  color         String
  icon          String
  type          TransactionType
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  createdAt     DateTime        @default(now())
  fixedExpenses FixedExpense[]

  @@index([userId])
}

model Transaction {
  id             String          @id @default(cuid())
  description    String?
  amount         Int
  date           DateTime
  type           TransactionType
  paymentMethod  PaymentMethod
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  fixedExpenseId String?
  fixedExpense   FixedExpense?   @relation(fields: [fixedExpenseId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@index([userId, date])
  @@index([categoryId])
  @@index([fixedExpenseId])
}

model Budget {
  id         String   @id @default(cuid())
  limit      Int?
  categoryId String // quita el @unique de aquí
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month      Int
  year       Int

  @@unique([categoryId, month, year])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String? // null si entró solo con Google
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  categories    Category[]
  fixedExpenses FixedExpense[]
  transactions  Transaction[]
  budgets       Budget[]
  createdAt     DateTime       @default(now())
}

model FixedExpense {
  id              String        @id @default(cuid())
  name            String // "Netflix", "Arriendo", "ENEL"
  estimatedAmount Int
  dayOfMonth      Int // día del mes en que normalmente se paga (1-31)
  isActive        Boolean       @default(true)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  createdAt       DateTime      @default(now())

  @@index([userId])
}
