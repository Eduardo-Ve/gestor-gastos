generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
}

enum PaymentMethod {
  cash
  debit
  credit
  transfer
  other
}

model Category {
  id                  String               @id @default(cuid())
  name                String
  color               String
  icon                String
  type                TransactionType
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  budgets             Budget[]
  createdAt           DateTime             @default(now())
  fixedExpenses       FixedExpense[]
  creditCardPurchases CreditCardPurchase[]

  @@index([userId])
}

model Transaction {
  id                    String                 @id @default(cuid())
  description           String?
  amount                Int
  date                  DateTime
  type                  TransactionType
  paymentMethod         PaymentMethod
  categoryId            String
  category              Category               @relation(fields: [categoryId], references: [id])
  fixedExpenseId        String?
  fixedExpense          FixedExpense?          @relation(fields: [fixedExpenseId], references: [id])
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime               @default(now())
  creditCardInstallment CreditCardInstallment?
  fixedExpensePayment   FixedExpensePayment?

  @@index([userId, date])
  @@index([categoryId])
  @@index([fixedExpenseId])
}

model Budget {
  id         String   @id @default(cuid())
  limit      Int?
  categoryId String // quita el @unique de aquí
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month      Int
  year       Int

  @@unique([categoryId, month, year])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  password            String? // null si entró solo con Google
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  categories          Category[]
  fixedExpenses       FixedExpense[]
  transactions        Transaction[]
  budgets             Budget[]
  createdAt           DateTime             @default(now())
  creditCards         CreditCard[]
  creditCardPurchases CreditCardPurchase[]
}

model FixedExpense {
  id           String                @id @default(cuid())
  description  String
  amount       Decimal
  dueDay       Int
  categoryId   String
  active       Boolean               @default(true)
  userId       String
  transactions Transaction[]
  category     Category              @relation(fields: [categoryId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  payments     FixedExpensePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FixedExpensePayment {
  id             String   @id @default(cuid())
  fixedExpenseId String
  period         DateTime
  transactionId  String?  @unique

  fixedExpense FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  transaction  Transaction? @relation(fields: [transactionId], references: [id])

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([fixedExpenseId, period])
}

model CreditCard {
  id         String               @id @default(cuid())
  name       String // "Falabella Visa", "Santander Latam Pass"
  cardLimit  Decimal // cupo total
  closingDay Int // día del mes que cierra el ciclo de facturación
  dueDay     Int // día del mes que vence el pago
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases  CreditCardPurchase[]

  createdAt DateTime @default(now())
}

model CreditCardPurchase {
  id                  String                  @id @default(cuid())
  description         String 
  totalAmount         Decimal 
  installmentsCount   Int //
  monthlyInterestRate Decimal                 @default(0) // 
  purchaseDate        DateTime
  categoryId          String
  category            Category                @relation(fields: [categoryId], references: [id])
  cardId              String
  card                CreditCard              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments        CreditCardInstallment[]

  createdAt DateTime @default(now())
}

model CreditCardInstallment {
  id                String             @id @default(cuid())
  purchaseId        String
  purchase          CreditCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  installmentNumber Int 
  amount            Decimal 
  billingPeriod     DateTime 
  paid              Boolean            @default(false)
  transactionId     String?            @unique
  transaction       Transaction?       @relation(fields: [transactionId], references: [id])

  @@unique([purchaseId, installmentNumber])
}
